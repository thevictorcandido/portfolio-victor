# Copie para .env.local e preencha com os dados do painel do EmailJS (https://dashboard.emailjs.com).
# O template precisa usar as variáveis {{name}}, {{email}} e {{message}}.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# reCAPTCHA v2 (caixa "Não sou um robô"). Só a Site Key; a Secret Key vai no painel do EmailJS.
VITE_RECAPTCHA_SITE_KEY=
